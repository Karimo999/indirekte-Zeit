{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Indirekte Zeit",
  "version": "../package.json",
  "identifier": "de.synofacio.indirektezeit",
  "build": {
    "frontendDist": "../dist/desktop",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Indirekte Zeit",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "SynoFacio UG",
    "copyright": "SynoFacio UG",
    "category": "Productivity",
    "shortDescription": "Indirekte Stunden in Kilanka-Leistungsnachweise eintragen",
    "longDescription": "Trägt indirekte Stunden und Gesamtstunden in Kilanka-Leistungsnachweise ein (Segeberg und Pinneberg).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RDY1MzU1NzY1OEE0NzcKUldSM3BGaDJWVlBXZEd1ekVXQlRlc08xaGkxSlYyMzMrdisrWDRPZUFGOUQzcFNDb0lzSGJrNVQK",
      "endpoints": ["https://github.com/OWNER/REPO/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
